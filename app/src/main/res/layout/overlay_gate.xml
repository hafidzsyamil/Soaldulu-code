<?xml version="1.0" encoding="utf-8"?>
<!--
    Overlay spike. Sengaja polos: tugasnya hanya membuktikan jendela bisa
    muncul di atas aplikasi lain dan seberapa cepat.

    Layar Gerbang yang sesungguhnya (Bagian 8 nomor 6) dibangun di Fase 2.
    Teks di sini sengaja hardcode karena berkas ini akan dibuang.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1714"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:ignore="HardcodedText">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HALO"
        android:textColor="#C9A962"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/teks_paket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="#E8DFD4"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Latensi event → overlay tampil"
        android:textColor="#9C8B7A"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/teks_latensi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#C9A962"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/teks_catatan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#9C8B7A"
        android:textSize="13sp" />

    <Button
        android:id="@+id/tombol_tutup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="TUTUP (hanya ada di spike)" />

</LinearLayout>
